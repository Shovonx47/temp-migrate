		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.8.0",
		"vite": "^6.3.0"
	},
	"imports": {
		"$lib": "./src/lib/index.js",
		"$lib/*": "./src/lib/*"
