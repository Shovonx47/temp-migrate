<?php

namespace App\Services\Health;

use App\Models\Message;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Redis;
use Laravel\Horizon\Contracts\SupervisorRepository;
use Laravel\Horizon\Contracts\WorkloadRepository;
use Throwable;

class SystemHealthChecker
{
    /**
     * Run all health checks and return the complete diagnostic dataset.
     *
     * @return array<string, mixed>
     */
    public function runAllChecks(): array
    {
        $cpu = $this->checkCpu();
        $db = $this->checkDatabase();
        $phpFpm = $this->checkPhpFpm();
        $nginx = $this->checkNginx();
        $disk = $this->checkDiskSpace();
        $load = $this->checkServerLoad();
        $memory = $this->checkMemory();
        $uptime = $this->checkUptime();
        $network = $this->checkNetwork();
        $redis = $this->checkRedis();
        $supervisor = $this->checkSupervisor();
        $queueWorker = $this->checkQueueWorker();
        $cron = $this->checkCron();
        $app = $this->checkApplication();

        // Calculate overall system health
        $statuses = [
            $cpu['status'],
            $db['status'],
            $phpFpm['status'],
            $nginx['status'],
            $disk['status'],
            $load['status'],
            $memory['status'],
            $redis['status'],
            $app['status'],
        ];

        $overallStatus = 'healthy';
        if (in_array('critical', $statuses, true)) {
            $overallStatus = 'critical';
        } elseif (in_array('warning', $statuses, true)) {
            $overallStatus = 'warning';
        }

        return [
            'overall' => [
                'status' => $overallStatus,
                'checked_at' => now()->format('Y-m-d H:i:s'),
                'server_time' => now()->toIso8601String(),
                'hostname' => gethostname() ?: 'unknown-host',
                'os' => PHP_OS_FAMILY . ' (' . php_uname('s') . ' ' . php_uname('r') . ')',
            ],
            'cpu' => $cpu,
            'database' => $db,
            'php_fpm' => $phpFpm,
            'nginx' => $nginx,
            'disk' => $disk,
            'load' => $load,
            'memory' => $memory,
            'uptime' => $uptime,
            'network' => $network,
            'redis' => $redis,
            'supervisor' => $supervisor,
            'queue_worker' => $queueWorker,
            'cron' => $cron,
            'application' => $app,
        ];
    }

    /**
     * Live CPU utilization and hardware core diagnostics.
     *
     * @return array<string, mixed>
     */
    public function checkCpu(): array
    {
        $cores = $this->getCpuCoreCount();
        $model = 'Multi-Core Processor';
        $usage = 0.0;

        if (@file_exists('/proc/cpuinfo')) {
            $cpuinfo = @file_get_contents('/proc/cpuinfo');
            if ($cpuinfo && preg_match('/model name\s*:\s*(.+)$/m', $cpuinfo, $m)) {
                $model = trim($m[1]);
            }
        }

        if (@file_exists('/proc/stat')) {
            $stat = @file_get_contents('/proc/stat');
            if ($stat) {
                $firstLine = explode("\n", $stat)[0];
                $parts = array_values(array_filter(explode(' ', $firstLine)));
                if (count($parts) >= 5) {
                    $user = (int) ($parts[1] ?? 0);
                    $nice = (int) ($parts[2] ?? 0);
                    $system = (int) ($parts[3] ?? 0);
                    $idle = (int) ($parts[4] ?? 0);
                    $iowait = (int) ($parts[5] ?? 0);
                    $irq = (int) ($parts[6] ?? 0);
                    $softirq = (int) ($parts[7] ?? 0);
                    $steal = (int) ($parts[8] ?? 0);

                    $currentIdle = $idle + $iowait;
                    $currentTotal = $user + $nice + $system + $idle + $iowait + $irq + $softirq + $steal;

                    $cached = Cache::get('sys_health_cpu_stat');
                    if ($cached && is_array($cached) && isset($cached['idle'], $cached['total'])) {
                        $deltaTotal = $currentTotal - $cached['total'];
                        $deltaIdle = $currentIdle - $cached['idle'];
                        if ($deltaTotal > 0) {
                            $usage = round((1 - ($deltaIdle / $deltaTotal)) * 100, 1);
                        }
                    } else {
                        // Instant 50ms delta for initial calculation
                        usleep(50000);
                        $stat2 = @file_get_contents('/proc/stat');
                        if ($stat2) {
                            $firstLine2 = explode("\n", $stat2)[0];
                            $parts2 = array_values(array_filter(explode(' ', $firstLine2)));
                            $idle2 = (int) ($parts2[4] ?? 0) + (int) ($parts2[5] ?? 0);
                            $total2 = array_sum(array_slice($parts2, 1));
                            $deltaTotal = $total2 - $currentTotal;
                            $deltaIdle = $idle2 - $currentIdle;
                            if ($deltaTotal > 0) {
                                $usage = round((1 - ($deltaIdle / $deltaTotal)) * 100, 1);
                            }
                        }
                    }

                    Cache::put('sys_health_cpu_stat', [
                        'idle' => $currentIdle,
                        'total' => $currentTotal,
                        'time' => microtime(true),
                    ], now()->addMinutes(5));
                }
            }
        }

        $usage = max(0.0, min(100.0, $usage));
        $status = $usage >= 90.0 ? 'critical' : ($usage >= 80.0 ? 'warning' : 'healthy');

        return [
            'status' => $status,
            'usage_percentage' => $usage,
            'cores' => $cores,
            'model' => $model,
        ];
    }

    /**
     * Database connectivity check with live PDO connection and latency measurement.
     *
     * @return array<string, mixed>
     */
    public function checkDatabase(): array
    {
        $start = microtime(true);
        $defaultConnection = config('database.default', 'mysql');
        $dbConfig = config("database.connections.{$defaultConnection}", []);

        try {
            $pdo = DB::connection($defaultConnection)->getPdo();
            $latencyMs = round((microtime(true) - $start) * 1000, 2);

            $versionResult = DB::selectOne('SELECT VERSION() as version');
            $databaseResult = DB::selectOne('SELECT DATABASE() as db_name');

            $threadsConnected = null;
            $maxConnections = null;
            try {
                $statusRow = DB::selectOne("SHOW STATUS LIKE 'Threads_connected'");
                if ($statusRow && isset($statusRow->Value)) {
                    $threadsConnected = (int) $statusRow->Value;
                }
                $varRow = DB::selectOne("SHOW VARIABLES LIKE 'max_connections'");
                if ($varRow && isset($varRow->Value)) {
                    $maxConnections = (int) $varRow->Value;
                }
            } catch (Throwable) {
            }

            $status = 'healthy';
            if ($latencyMs > 500) {
                $status = 'critical';
            } elseif ($latencyMs > 100) {
                $status = 'warning';
            }

            return [
                'status' => $status,
                'latency_ms' => $latencyMs,
                'connection' => $defaultConnection,
                'host' => $dbConfig['host'] ?? '127.0.0.1',
                'port' => $dbConfig['port'] ?? 3306,
                'database' => $databaseResult->db_name ?? ($dbConfig['database'] ?? 'unknown'),
                'server_version' => $versionResult->version ?? 'Unknown',
                'driver' => $pdo->getAttribute(\PDO::ATTR_DRIVER_NAME),
                'active_threads' => $threadsConnected,
                'max_connections' => $maxConnections,
                'error' => null,
            ];
        } catch (Throwable $e) {
            $latencyMs = round((microtime(true) - $start) * 1000, 2);

            return [
                'status' => 'critical',
                'latency_ms' => $latencyMs,
                'connection' => $defaultConnection,
                'host' => $dbConfig['host'] ?? '127.0.0.1',
                'port' => $dbConfig['port'] ?? 3306,
                'database' => $dbConfig['database'] ?? 'unknown',
                'server_version' => 'Unavailable',
                'driver' => $defaultConnection,
                'active_threads' => null,
                'max_connections' => null,
                'error' => $e->getMessage(),
            ];
        }
    }

    /**
     * PHP-FPM service status check and PHP runtime diagnostics.
     *
     * @return array<string, mixed>
     */
    public function checkPhpFpm(): array
    {
        $status = 'healthy';
        $serviceState = 'active';
        $fpmProcCount = 0;

        // Scan Linux /proc for running php-fpm processes
        foreach (glob('/proc/[0-9]*/cmdline') as $cmdFile) {
            $cmd = @file_get_contents($cmdFile);
            if ($cmd && str_contains($cmd, 'php-fpm')) {
                $fpmProcCount++;
            }
        }

        if ($fpmProcCount > 0 || str_contains(PHP_SAPI, 'fpm')) {
            $status = 'healthy';
            $serviceState = 'active';
        } else {
            $serviceState = PHP_SAPI;
            $status = 'healthy';
        }

        // OPcache diagnostics
        $opcacheEnabled = false;
        $opcacheHitRate = null;
        $opcacheUsedMb = null;
        if (function_exists('opcache_get_status')) {
            $opStatus = @opcache_get_status(false);
            if (is_array($opStatus)) {
                $opcacheEnabled = (bool) ($opStatus['opcache_enabled'] ?? false);
                $stats = $opStatus['opcache_statistics'] ?? [];
                $opcacheHitRate = isset($stats['opcache_hit_rate']) ? round($stats['opcache_hit_rate'], 1) : null;
                $mem = $opStatus['memory_usage'] ?? [];
                if (isset($mem['used_memory'])) {
                    $opcacheUsedMb = round($mem['used_memory'] / 1024 / 1024, 1);
                }
            }
        }

        return [
            'status' => $status,
            'service_name' => 'php-fpm-84',
            'service_state' => $serviceState,
            'detail_message' => null,
            'php_version' => PHP_VERSION,
            'sapi_name' => PHP_SAPI,
            'process_count' => $fpmProcCount,
            'zend_version' => zend_version(),
            'opcache_enabled' => $opcacheEnabled,
            'opcache_hit_rate' => $opcacheHitRate,
            'opcache_used_mb' => $opcacheUsedMb,
            'memory_limit' => ini_get('memory_limit'),
            'max_execution_time' => ini_get('max_execution_time') . 's',
            'upload_max_filesize' => ini_get('upload_max_filesize'),
            'post_max_size' => ini_get('post_max_size'),
        ];
    }

    /**
     * Nginx web server service status check and live connection count.
     *
     * @return array<string, mixed>
     */
    public function checkNginx(): array
    {
        $status = 'healthy';
        $serviceState = 'active';
        $activeConnections = 1;
        $version = null;

        // Query aaPanel Nginx stub status directly
        $statusHtml = @file_get_contents('http://127.0.0.1/nginx_status');
        if ($statusHtml && preg_match('/Active connections:\s+(\d+)/i', $statusHtml, $m)) {
            $activeConnections = (int) $m[1];
        } else {
            $fp = @fsockopen('127.0.0.1', 80, $errno, $errstr, 0.5);
            if ($fp) {
                fclose($fp);
            } else {
                $status = 'warning';
                $serviceState = 'unknown';
            }
        }

        $serverSoftware = $_SERVER['SERVER_SOFTWARE'] ?? null;
        if ($serverSoftware && preg_match('/nginx\/([0-9\.]+)/i', $serverSoftware, $m)) {
            $version = $m[1];
        }

        return [
            'status' => $status,
            'service_state' => $serviceState,
            'active_connections' => $activeConnections,
            'nginx_version' => $version,
            'server_software' => $serverSoftware ?: 'nginx',
            'detail_message' => null,
        ];
    }

    /**
     * Root filesystem disk space check (Total, Used, Free in GB and %).
     *
     * @return array<string, mixed>
     */
    public function checkDiskSpace(): array
    {
        $targetPath = PHP_OS_FAMILY === 'Windows' ? base_path() : '/';

        $freeBytes = @disk_free_space($targetPath);
        $totalBytes = @disk_total_space($targetPath);

        if ($freeBytes === false || $totalBytes === false || $totalBytes <= 0) {
            return [
                'status' => 'warning',
                'path' => $targetPath,
                'total_gb' => 0,
                'used_gb' => 0,
                'free_gb' => 0,
                'used_percentage' => 0,
                'free_percentage' => 0,
                'error' => 'Unable to read disk statistics for target filesystem',
            ];
        }

        $usedBytes = max(0, $totalBytes - $freeBytes);
        $usedPercentage = round(($usedBytes / $totalBytes) * 100, 1);
        $freePercentage = round(($freeBytes / $totalBytes) * 100, 1);

        $totalGb = round($totalBytes / (1024 * 1024 * 1024), 2);
        $usedGb = round($usedBytes / (1024 * 1024 * 1024), 2);
        $freeGb = round($freeBytes / (1024 * 1024 * 1024), 2);

        $status = 'healthy';
        if ($usedPercentage >= 90) {
            $status = 'critical';
        } elseif ($usedPercentage >= 80) {
            $status = 'warning';
        }

        return [
            'status' => $status,
            'path' => $targetPath,
            'total_gb' => $totalGb,
            'used_gb' => $usedGb,
            'free_gb' => $freeGb,
            'used_percentage' => $usedPercentage,
            'free_percentage' => $freePercentage,
            'error' => null,
        ];
    }

    /**
     * Server load average (1m, 5m, 15m) thresholded against CPU cores.
     *
     * @return array<string, mixed>
     */
    public function checkServerLoad(): array
    {
        $cores = $this->getCpuCoreCount();
        $load1 = null;
        $load5 = null;
        $load15 = null;
        $status = 'healthy';
        $detailMessage = null;

        if (function_exists('sys_getloadavg')) {
            $loads = @sys_getloadavg();
            if (is_array($loads) && count($loads) >= 3) {
                $load1 = round((float) $loads[0], 2);
                $load5 = round((float) $loads[1], 2);
                $load15 = round((float) $loads[2], 2);
            }
        }

        if ($load1 === null && @file_exists('/proc/loadavg')) {
            $content = @file_get_contents('/proc/loadavg');
            if ($content) {
                $parts = explode(' ', trim($content));
                if (count($parts) >= 3) {
                    $load1 = round((float) $parts[0], 2);
                    $load5 = round((float) $parts[1], 2);
                    $load15 = round((float) $parts[2], 2);
                }
            }
        }

        $load1 = $load1 ?? 0.0;
        $load5 = $load5 ?? 0.0;
        $load15 = $load15 ?? 0.0;

        if ($load1 > ($cores * 2.0)) {
            $status = 'critical';
            $detailMessage = "1-minute load ({$load1}) is severely exceeding CPU capacity ({$cores} cores)";
        } elseif ($load1 > ($cores * 1.0)) {
            $status = 'warning';
            $detailMessage = "1-minute load ({$load1}) is elevated above baseline capacity ({$cores} cores)";
        }

        return [
            'status' => $status,
            'cpu_cores' => $cores,
            'load_1m' => $load1,
            'load_5m' => $load5,
            'load_15m' => $load15,
            'load_str' => "{$load1}, {$load5}, {$load15}",
            'load_percentage' => $cores > 0 ? round(($load1 / $cores) * 100, 1) : null,
            'detail_message' => $detailMessage,
        ];
    }

    /**
     * Server memory (RAM) check from /proc/meminfo in both GB and MB.
     *
     * @return array<string, mixed>
     */
    public function checkMemory(): array
    {
        $totalMb = 0.0;
        $freeMb = 0.0;
        $availableMb = 0.0;
        $usedMb = 0.0;
        $totalGb = 0.0;
        $usedGb = 0.0;
        $freeGb = 0.0;
        $availableGb = 0.0;
        $usedPercentage = 0.0;
        $status = 'healthy';
        $detailMessage = null;

        if (@file_exists('/proc/meminfo')) {
            $meminfo = @file_get_contents('/proc/meminfo');
            if ($meminfo) {
                $data = [];
                foreach (explode("\n", $meminfo) as $line) {
                    if (str_contains($line, ':')) {
                        [$key, $val] = explode(':', $line, 2);
                        $data[trim($key)] = (int) filter_var($val, FILTER_SANITIZE_NUMBER_INT);
                    }
                }

                if (isset($data['MemTotal']) && $data['MemTotal'] > 0) {
                    $totalKb = (int) $data['MemTotal'];
                    $availKb = (int) ($data['MemAvailable'] ?? ($data['MemFree'] ?? 0));
                    $freeKb = (int) ($data['MemFree'] ?? 0);
                    $usedKb = max(0, $totalKb - $availKb);

                    $totalMb = round($totalKb / 1024, 1);
                    $availableMb = round($availKb / 1024, 1);
                    $usedMb = round($usedKb / 1024, 1);
                    $freeMb = round($freeKb / 1024, 1);

                    $totalGb = round($totalKb / (1024 * 1024), 2);
                    $usedGb = round($usedKb / (1024 * 1024), 2);
                    $freeGb = round($freeKb / (1024 * 1024), 2);
                    $availableGb = round($availKb / (1024 * 1024), 2);

                    $usedPercentage = round(($usedKb / $totalKb) * 100, 1);
                }
            }
        }

        if ($usedPercentage >= 90) {
            $status = 'critical';
            $detailMessage = "RAM utilization ({$usedPercentage}%) is critically high";
        } elseif ($usedPercentage >= 80) {
            $status = 'warning';
            $detailMessage = "RAM utilization ({$usedPercentage}%) is approaching capacity";
        }

        $phpCurrentMb = round(memory_get_usage(true) / 1024 / 1024, 2);
        $phpPeakMb = round(memory_get_peak_usage(true) / 1024 / 1024, 2);

        return [
            'status' => $status,
            'total_gb' => $totalGb,
            'used_gb' => $usedGb,
            'free_gb' => $freeGb,
            'available_gb' => $availableGb,
            'total_mb' => $totalMb,
            'used_mb' => $usedMb,
            'free_mb' => $freeMb,
            'available_mb' => $availableMb,
            'used_percentage' => $usedPercentage,
            'php_current_mb' => $phpCurrentMb,
            'php_peak_mb' => $phpPeakMb,
            'memory_limit' => ini_get('memory_limit'),
            'detail_message' => $detailMessage,
        ];
    }

    /**
     * Server uptime check from /proc/uptime.
     *
     * @return array<string, mixed>
     */
    public function checkUptime(): array
    {
        $uptimeSec = 0.0;
        if (@file_exists('/proc/uptime')) {
            $content = @file_get_contents('/proc/uptime');
            if ($content) {
                $uptimeSec = (float) explode(' ', trim($content))[0];
            }
        }

        $totalSeconds = (int) floor($uptimeSec);
        $days = (int) floor($totalSeconds / 86400);
        $hours = (int) floor(($totalSeconds % 86400) / 3600);
        $minutes = (int) floor(($totalSeconds % 3600) / 60);

        return [
            'seconds' => $totalSeconds,
            'days' => $days,
            'hours' => $hours,
            'minutes' => $minutes,
            'formatted' => "{$days}d {$hours}h {$minutes}m",
        ];
    }

    /**
     * Live network traffic statistics and throughput rates from /proc/net/dev.
     *
     * @return array<string, mixed>
     */
    public function checkNetwork(): array
    {
        $rxBytes = 0.0;
        $txBytes = 0.0;

        if (@file_exists('/proc/net/dev')) {
            $netdev = @file_get_contents('/proc/net/dev');
            if ($netdev) {
                foreach (explode("\n", $netdev) as $line) {
                    if (str_contains($line, ':')) {
                        [$iface, $stats] = explode(':', $line, 2);
                        $iface = trim($iface);
                        if ($iface === 'lo' || str_starts_with($iface, 'docker') || str_starts_with($iface, 'br-')) {
                            continue;
                        }
                        $cols = preg_split('/\s+/', trim($stats));
                        if (count($cols) >= 9) {
                            $rxBytes += (float) ($cols[0] ?? 0);
                            $txBytes += (float) ($cols[8] ?? 0);
                        }
                    }
                }
            }
        }

        $now = microtime(true);
        $cached = Cache::get('sys_health_net_io');
        $rxRateBps = 0.0;
        $txRateBps = 0.0;

        if ($cached && is_array($cached) && isset($cached['rx'], $cached['tx'], $cached['time'])) {
            $deltaTime = max(0.1, $now - (float) $cached['time']);
            $deltaRx = max(0.0, $rxBytes - (float) $cached['rx']);
            $deltaTx = max(0.0, $txBytes - (float) $cached['tx']);
            $rxRateBps = $deltaRx / $deltaTime;
            $txRateBps = $deltaTx / $deltaTime;
        }

        Cache::put('sys_health_net_io', [
            'rx' => $rxBytes,
            'tx' => $txBytes,
            'time' => $now,
        ], now()->addMinutes(5));

        $formatBytes = function (float $bytes): string {
            if ($bytes >= 1073741824) {
                return round($bytes / 1073741824, 2) . ' GB';
            }
            if ($bytes >= 1048576) {
                return round($bytes / 1048576, 1) . ' MB';
            }
            if ($bytes >= 1024) {
                return round($bytes / 1024, 1) . ' KB';
            }

            return round($bytes) . ' B';
        };

        $formatRate = function (float $bps): string {
            $mbps = ($bps * 8) / 1000000;
            if ($mbps >= 1.0) {
                return round($mbps, 1) . ' Mbps';
            }
            $kbps = ($bps * 8) / 1000;
            if ($kbps >= 1.0) {
                return round($kbps, 0) . ' Kbps';
            }

            return round($bps / 1024, 1) . ' KB/s';
        };

        $rxFormatted = $formatBytes($rxBytes);
        $txFormatted = $formatBytes($txBytes);
        $rxRateStr = $formatRate($rxRateBps);
        $txRateStr = $formatRate($txRateBps);

        $display = ($rxRateBps > 0 || $txRateBps > 0)
            ? "{$rxRateStr} / {$txRateStr}"
            : "{$rxFormatted} / {$txFormatted}";

        return [
            'rx_bytes' => $rxBytes,
            'tx_bytes' => $txBytes,
            'rx_formatted' => $rxFormatted,
            'tx_formatted' => $txFormatted,
            'rx_rate_str' => $rxRateStr,
            'tx_rate_str' => $txRateStr,
            'display' => $display,
        ];
    }

    /**
     * Real Redis memory, hit rate, and connection status.
     *
     * @return array<string, mixed>
     */
    public function checkRedis(): array
    {
        try {
            $redis = Redis::connection();
            $info = $redis->info();

            $usedMem = $info['used_memory_human'] ?? '0 MB';
            $peakMem = $info['used_memory_peak_human'] ?? '0 MB';
            $clients = (int) ($info['connected_clients'] ?? 0);
            $hits = (int) ($info['keyspace_hits'] ?? 0);
            $misses = (int) ($info['keyspace_misses'] ?? 0);
            $totalHits = $hits + $misses;
            $hitRate = $totalHits > 0 ? round(($hits / $totalHits) * 100, 1) : 100.0;

            return [
                'status' => 'healthy',
                'label' => 'Online',
                'used_memory' => $usedMem,
                'peak_memory' => $peakMem,
                'connected_clients' => $clients,
                'hit_rate' => $hitRate,
                'error' => null,
            ];
        } catch (Throwable $e) {
            return [
                'status' => 'critical',
                'label' => 'Offline',
                'used_memory' => 'N/A',
                'peak_memory' => 'N/A',
                'connected_clients' => 0,
                'hit_rate' => 0.0,
                'error' => $e->getMessage(),
            ];
        }
    }

    /**
     * Supervisor process health and active supervisor workers.
     *
     * @return array<string, mixed>
     */
    public function checkSupervisor(): array
    {
        $status = 'healthy';
        $label = 'Running';
        $procCount = 0;

        try {
            if (class_exists(SupervisorRepository::class)) {
                $supervisors = app(SupervisorRepository::class)->all();
                foreach ($supervisors as $s) {
                    $procCount += array_sum($s->processes ?? []);
                }
            }
        } catch (Throwable) {
        }

        if ($procCount === 0) {
            foreach (glob('/proc/[0-9]*/cmdline') as $cmdFile) {
                $cmd = @file_get_contents($cmdFile);
                if ($cmd && (str_contains($cmd, 'horizon:work') || str_contains($cmd, 'queue:work'))) {
                    $procCount++;
                }
            }
        }

        $daemonRunning = false;
        foreach (glob('/proc/[0-9]*/cmdline') as $cmdFile) {
            $cmd = @file_get_contents($cmdFile);
            if ($cmd && str_contains($cmd, 'supervisord')) {
                $daemonRunning = true;
                break;
            }
        }

        if ($procCount > 0 || $daemonRunning) {
            $status = 'healthy';
            $label = 'Running';
        } else {
            $status = 'warning';
            $label = 'Inactive';
        }

        return [
            'status' => $status,
            'label' => $label,
            'process_count' => $procCount > 0 ? $procCount : ($daemonRunning ? 1 : 0),
        ];
    }

    /**
     * Real worker pool statistics (Total, Active, Idle).
     *
     * @return array<string, mixed>
     */
    public function checkQueueWorker(): array
    {
        $totalWorkers = 0;
        $activeWorkers = 0;

        try {
            if (class_exists(WorkloadRepository::class)) {
                $workloads = app(WorkloadRepository::class)->get();
                foreach ($workloads as $w) {
                    $procs = (int) ($w['processes'] ?? 0);
                    $totalWorkers += $procs;
                    $len = (int) ($w['length'] ?? 0);
                    if ($len > 0) {
                        $activeWorkers += min($procs, $len);
                    }
                }
            }
        } catch (Throwable) {
        }

        if ($totalWorkers === 0) {
            foreach (glob('/proc/[0-9]*/cmdline') as $cmdFile) {
                $cmd = @file_get_contents($cmdFile);
                if ($cmd && (str_contains($cmd, 'horizon:work') || str_contains($cmd, 'queue:work'))) {
                    $totalWorkers++;
                }
            }
        }

        $inFlight = Message::withoutGlobalScopes()
            ->where('status', 'sending')
            ->count();
        if ($inFlight > 0) {
            $activeWorkers = max($activeWorkers, min($totalWorkers, $inFlight));
        }

        $idleWorkers = max(0, $totalWorkers - $activeWorkers);
        $activePct = $totalWorkers > 0 ? round(($activeWorkers / $totalWorkers) * 100, 1) : 0.0;
        $idlePct = $totalWorkers > 0 ? round(($idleWorkers / $totalWorkers) * 100, 1) : 100.0;

        return [
            'status' => $totalWorkers > 0 ? 'Active' : 'Idle',
            'total' => $totalWorkers,
            'active' => $activeWorkers,
            'active_pct' => $activePct,
            'idle' => $idleWorkers,
            'idle_pct' => $idlePct,
        ];
    }

    /**
     * Cron service status check.
     *
     * @return array<string, mixed>
     */
    public function checkCron(): array
    {
        $cronRunning = false;
        foreach (glob('/proc/[0-9]*/cmdline') as $cmdFile) {
            $cmd = @file_get_contents($cmdFile);
            if ($cmd && (str_contains($cmd, 'cron') || str_contains($cmd, 'crond'))) {
                $cronRunning = true;
                break;
            }
        }

        return [
            'status' => $cronRunning ? 'healthy' : 'warning',
            'label' => $cronRunning ? 'Running' : 'Inactive',
            'interval' => '1m interval',
        ];
    }

    /**
     * Application-level configuration & storage integrity checks.
     *
     * @return array<string, mixed>
     */
    public function checkApplication(): array
    {
        $isMaintenance = app()->isDownForMaintenance();

        $privatePath = storage_path('app/private');
        $privateDirExists = is_dir($privatePath);
        $privateWritable = false;
        $privateError = null;

        if (! $privateDirExists) {
            @mkdir($privatePath, 0755, true);
            $privateDirExists = is_dir($privatePath);
        }

        if ($privateDirExists) {
            $probeFile = $privatePath . '/.health_probe_' . uniqid('', true);
            $bytesWritten = @file_put_contents($probeFile, 'health-check');
            if ($bytesWritten !== false) {
                $privateWritable = true;
                @unlink($probeFile);
            } else {
                $privateError = 'Failed writing probe test file to directory';
            }
        } else {
            $privateError = 'Directory does not exist and could not be created';
        }

        $appKey = (string) config('app.key');
        $hasAppKey = ! empty($appKey);

        $status = 'healthy';
        if ($isMaintenance) {
            $status = 'warning';
        }
        if (! $privateWritable || ! $hasAppKey) {
            $status = 'critical';
        }

        return [
            'status' => $status,
            'is_maintenance' => $isMaintenance,
            'maintenance_label' => $isMaintenance ? 'Maintenance Active' : 'Live / Operational',
            'private_storage_path' => $privatePath,
            'private_storage_writable' => $privateWritable,
            'private_storage_error' => $privateError,
            'has_app_key' => $hasAppKey,
            'app_key_cipher' => config('app.cipher', 'AES-256-CBC'),
            'environment' => app()->environment(),
            'debug_mode' => (bool) config('app.debug'),
            'cache_driver' => config('cache.default', 'file'),
            'session_driver' => config('session.driver', 'database'),
        ];
    }

    /**
     * Detect total number of CPU cores.
     */
    private function getCpuCoreCount(): int
    {
        if (PHP_OS_FAMILY === 'Windows') {
            $envCores = getenv('NUMBER_OF_PROCESSORS');
            if ($envCores && is_numeric($envCores)) {
                return (int) $envCores;
            }
        }

        if (@file_exists('/proc/cpuinfo')) {
            $cpuinfo = @file_get_contents('/proc/cpuinfo');
            if ($cpuinfo) {
                preg_match_all('/^processor/m', $cpuinfo, $matches);
                if (! empty($matches[0])) {
                    return count($matches[0]);
                }
            }
        }

        if ($this->isShellExecAvailable()) {
            $nproc = $this->executeSafeCommand('nproc 2>/dev/null');
            if ($nproc && is_numeric(trim((string) $nproc))) {
                return (int) trim((string) $nproc);
            }
        }

        return 1;
    }

    /**
     * Check whether shell_exec is available and not disabled in php.ini.
     */
    public function isShellExecAvailable(): bool
    {
        if (! function_exists('shell_exec')) {
            return false;
        }

        $disabled = explode(',', (string) ini_get('disable_functions'));
        $disabled = array_map('trim', $disabled);

        return ! in_array('shell_exec', $disabled, true);
    }

    /**
     * Safely execute a read-only shell command with error suppression.
     */
    private function executeSafeCommand(string $command): ?string
    {
        if (! $this->isShellExecAvailable()) {
            return null;
        }

        try {
            return @shell_exec($command);
        } catch (Throwable) {
            return null;
        }
    }
}
